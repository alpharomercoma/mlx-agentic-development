{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/scripts/check-mlx-env.sh",
            "timeout": 20,
            "statusMessage": "Checking MLX environment"
          }
        ]
      }
    ]
  }
}
